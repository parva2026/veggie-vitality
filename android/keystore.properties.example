# Copy to `android/keystore.properties` and fill in - that file is gitignored.
#
# Keep the keystore OUTSIDE the repository. A path under your home directory
# cannot be committed by accident, however badly a `git add -A` goes; a path
# inside the working tree is one stale .gitignore away from being published.
# Splitting the two halves this way means neither the repo nor the keystore
# alone is enough to sign as you.
#
# Create the keystore once:
#
#   keytool -genkeypair -v -keystore ~/.veggie-signing/veggie-release.jks #           -storetype PKCS12 -alias veggie #           -keyalg RSA -keysize 4096 -validity 10000
#
# keytool prompts for a password and for name/organisation fields. Those fields
# are embedded in the certificate and visible to anyone who inspects the APK, so
# for an app you hand to family, prefer the app's name over your own.
#
# BACK UP THE KEYSTORE AND THE PASSWORD, TOGETHER. Losing them means you can
# never update an installed copy of the app: Android refuses any update whose
# signature does not match, leaving only uninstall-and-reinstall, which wipes
# the user's data.
#
# The two password lines are optional. Delete them and export
# VEGGIE_STORE_PASSWORD instead, and the plaintext never touches the disk.

storeFile=C:/Users/you/.veggie-signing/veggie-release.jks
keyAlias=veggie
storePassword=CHANGE_ME
keyPassword=CHANGE_ME
