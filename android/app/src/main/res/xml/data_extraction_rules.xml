<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ (API 31) equivalent of backup_rules.xml. Excludes both cloud backup
  and device-to-device transfer: health data and the API key stay on this device.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="." />
        <exclude domain="database" path="." />
        <exclude domain="file" path="app_webview" />
        <exclude domain="root" path="app_webview" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="." />
        <exclude domain="database" path="." />
        <exclude domain="file" path="app_webview" />
        <exclude domain="root" path="app_webview" />
    </device-transfer>
</data-extraction-rules>
